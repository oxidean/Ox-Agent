{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "invocation_id",
    "skill",
    "status",
    "verdict",
    "summary",
    "artifacts",
    "findings",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "invocation_id": {
      "type": "string"
    },
    "skill": {
      "const": "ox-agent/progress"
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "failed"
      ]
    },
    "verdict": {
      "enum": [
        "pass",
        "pass_with_notes",
        "needs_rework",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "description": "Files produced or touched by this run. String entries are bare relative paths; attach summaries or annotations as extra fields on {path, ...} objects, never glued onto the path string."
    },
    "findings": {
      "type": "array"
    },
    "spec_impact": {
      "type": "object",
      "properties": {
        "consulted": {
          "type": "array",
          "items": { "type": "string" },
          "description": "index paths of specs of record this run read and reconciled against"
        },
        "conforms": {
          "type": "boolean",
          "description": "false declares that the change contradicts a spec of record"
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["spec", "summary", "resolution"],
            "properties": {
              "spec": { "type": "string" },
              "summary": { "type": "string" },
              "resolution": {
                "enum": ["updated", "proposed", "unresolved"],
                "description": "updated = the spec file already changed to match; proposed/unresolved = drift a human must resolve"
              }
            },
            "additionalProperties": true
          }
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "summary": { "type": "string" }
            },
            "additionalProperties": true
          },
          "description": "context/specs files this run wrote or amended"
        }
      },
      "additionalProperties": true,
      "description": "Spec reconciliation: which specs of record this run consulted, whether the change conforms, and any drift it declares or resolves. Collection journals this as spec.checked/spec.drift and, under strict policy, parks unresolved drift behind a human decision."
    },
    "next_action": {
      "type": "object",
      "required": [
        "type",
        "reason"
      ],
      "properties": {
        "type": {
          "enum": [
            "advance_stage",
            "retry",
            "escalate",
            "await_input",
            "complete"
          ]
        },
        "reason": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "description": "answer choices for an await_input decision request"
        }
      },
      "additionalProperties": true
    }
  }
}
