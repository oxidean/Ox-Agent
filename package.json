{
  "name": "@oxidean/ox-agent",
  "version": "0.1.1",
  "description": "Repository-local, token-efficient AI software development lifecycle kit",
  "type": "module",
  "bin": {
    "ox-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run build && bun test",
    "package": "bun run build && bun pm pack",
    "validate": "bun run build && bun dist/cli.js doctor",
    "validate-package": "bun run package && bun scripts/validate-package.mjs",
    "version": "bun dist/cli.js --version"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.4.0"
}
