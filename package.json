    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.4.0"
